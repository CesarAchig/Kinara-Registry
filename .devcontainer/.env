# Configuración de PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kinara_dev
POSTGRES_HOSTNAME=localhost
POSTGRES_PORT=5432

# Configuración de Garage S3 (Almacenamiento S3 en Rust para el CAS)
GARAGE_DEFAULT_ACCESS_KEY=GKkinaradev0000000000000000
GARAGE_DEFAULT_SECRET_KEY=7d37d093435a41f2aab8f13c19ba067d9776c90215f56614adad6ece597dbb34
GARAGE_DEFAULT_BUCKET=kinara-cas

# Variables de entorno para la aplicación Kinara Registry
KINARA_PORT=8080
KINARA_ENV=development
KINARA_DB_DSN=postgres://postgres:postgres@localhost:5432/kinara_dev?sslmode=disable
KINARA_S3_ENDPOINT=http://localhost:3900
KINARA_S3_REGION=garage
KINARA_S3_BUCKET=kinara-cas
KINARA_S3_ACCESS_KEY=GKkinaradev0000000000000000
KINARA_S3_SECRET_KEY=7d37d093435a41f2aab8f13c19ba067d9776c90215f56614adad6ece597dbb34
KINARA_LOG_LEVEL=debug
